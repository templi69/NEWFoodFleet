<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Title -->
    <TextView
        android:text="Rider Delivery Panel"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Order ID -->
    <EditText
        android:id="@+id/etOrderId"
        android:hint="Order ID"
        android:textColor="@color/white"
        android:textColorHint="#BBBBBB"
        android:backgroundTint="@color/primary"
        android:drawableStart="@android:drawable/ic_menu_info_details"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Pickup Location -->
    <EditText
        android:id="@+id/etPickup"
        android:hint="Restaurant Pickup Location"
        android:textColor="@color/white"
        android:textColorHint="#BBBBBB"
        android:backgroundTint="@color/primary"
        android:layout_marginTop="14dp"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Delivery Address -->
    <EditText
        android:id="@+id/etDelivery"
        android:hint="Customer Delivery Address"
        android:textColor="@color/white"
        android:textColorHint="#BBBBBB"
        android:backgroundTint="@color/primary"
        android:layout_marginTop="14dp"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Action Button -->
    <Button
        android:id="@+id/btnUpdateStatus"
        android:text="MARK AS DELIVERED"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/primary"
        android:layout_marginTop="28dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"/>

</LinearLayout>
